            "value": "postman-cash-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Cash\",\n  \"vehicleId\": \"VH-NL-347\",\n  \"startDate\": \"2030-01-01T10:00:00Z\",\n  \"endDate\": \"2030-01-02T10:00:00Z\",\n  \"vehicleCategory\": \"COMPACT\",\n  \"paymentMethod\": \"CASH\"\n}"
        },
        "url": "{{baseUrl}}/v1/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
