# Application / database
DB_URL=jdbc:postgresql://localhost:35432/velocity-motors-carrental
DB_USERNAME=booking-service
DB_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=car-booking-service
BANK_TRANSFER_PAYMENT_EVENTS_TOPIC=bank-transfer-payment-events
BANK_TRANSFER_PAYMENT_EVENTS_DLT_TOPIC=bank-transfer-payment-events.DLT

# Credit-card validation service
CREDIT_CARD_PAYMENT_BASE_URL=http://localhost:9090/credit-card-payment-api

# Observability
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
TRACING_SAMPLING_PROBABILITY=0.1

# Assignment assumption: configurable daily rental rates
PRICE_COMPACT_PER_DAY=50.00
PRICE_SEDAN_PER_DAY=70.00
PRICE_SUV_PER_DAY=90.00
PRICE_LUXURY_PER_DAY=120.00
