{
  "request": {
    "method": "POST",
    "url": "/credit-card-payment-api/payment-status",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.paymentReference == 'DL404404404')]"
      }
    ]
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "Payment not found"
    }
  }
}